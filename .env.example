# ─────────────────────────────────────────────────────────────────────────
# BLASTHub environment variables.
# Copy to .env.local for development. NEVER commit a filled-in copy.
#
# Classification:
#   PUBLIC       shipped to the browser; safe to expose (Firebase client config)
#   SERVER-ONLY  read by API routes; must not be prefixed NEXT_PUBLIC_
#   SECRET       server-only AND confidential; use Secret Manager in production
# ─────────────────────────────────────────────────────────────────────────

# ── SECRET ───────────────────────────────────────────────────────────────
# Gemini 2.5 Pro interpretation. Without it the app is fully functional but
# the AI panel reports "unavailable" and shows a deterministic local summary.
# Get a key from https://aistudio.google.com/apikey
# Production: store in Secret Manager and attach with
#   gcloud run services update blasthub --set-secrets GEMINI_API_KEY=gemini-api-key:latest
GEMINI_API_KEY=

# ── SERVER-ONLY ──────────────────────────────────────────────────────────
# Shared result storage. REQUIRED in production: Cloud Run runs several
# instances and container-local files are invisible to the others.
BLAST_RESULTS_BUCKET=blasthub-results-super-blast-497610

# Comma-separated emails allowed to call GET /api/blast/test.
# Leave empty to disable the diagnostics endpoint entirely (it returns 404).
ADMIN_EMAILS=

# Override the BLAST database directory. Defaults to /app/blastdb in
# production and ./blastdb in development.
# BLASTDB=/app/blastdb

# ── PUBLIC (Firebase client config; safe in the browser by design) ───────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=super-blast-497610.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=super-blast-497610
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=super-blast-497610.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=523316980019
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
