# ─────────────────────────────────────────────────────────────────────────
# BLASTHub base image: NCBI BLAST+ and the reference databases.
#
# This layer is expensive (it downloads BLAST+ and indexes every database) and
# changes only when the engine version or a database definition changes.
# Splitting it out of the application image is the fix for the
# five-minutes-every-deploy problem: application builds start FROM this tag and
# skip the download and indexing entirely.
#
# Rebuild and push only when a database or the BLAST+ version changes:
#   gcloud builds submit --config cloudbuild-base.yaml .
#
# Tag convention: blast<version>-db<revision>, e.g. blast2.17.0-db3
# ─────────────────────────────────────────────────────────────────────────
FROM node:20-slim

ARG BLAST_VERSION=2.17.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gzip tar ca-certificates libgomp1 curl coreutils \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q -O blast.tar.gz \
      "https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/${BLAST_VERSION}/ncbi-blast-${BLAST_VERSION}+-x64-linux.tar.gz" \
 && tar -xzf blast.tar.gz \
 && cp -r "ncbi-blast-${BLAST_VERSION}+/bin/." /usr/local/bin/ \
 && rm -rf blast.tar.gz "ncbi-blast-${BLAST_VERSION}+" \
 && blastn -version && makeblastdb -version && blastdbcmd -version

COPY scripts/build-blastdb.sh /usr/local/bin/build-blastdb.sh
RUN chmod +x /usr/local/bin/build-blastdb.sh

ENV DBDIR=/app/blastdb
ENV BLASTDB=/app/blastdb
RUN mkdir -p /app/blastdb

# NCBI taxonomy lookup tables. Without taxdb.btd/taxdb.bti, BLAST+ records each
# hit's taxid but cannot resolve it to a scientific name: `sciname` is then
# absent from the JSON output and the UI shows "Unknown" for every organism.
RUN cd /app/blastdb \
 && wget -q --tries=3 --timeout=60 -O taxdb.tar.gz "https://ftp.ncbi.nlm.nih.gov/blast/db/taxdb.tar.gz" \
 && tar -xzf taxdb.tar.gz && rm taxdb.tar.gz \
 && ls -la taxdb.btd taxdb.bti

# Each database is built, verified with `blastdbcmd -info`, and recorded with
# its provenance. build-blastdb.sh exits non-zero if any of that fails, so a
# broken database fails the build instead of shipping as "Ready".
#
# The trailing number is the NCBI taxonomy ID applied to every sequence.

# Drosophila melanogaster — RefSeq transcripts (GCF_000001215.4, Release 6 plus ISO1 MT)
RUN build-blastdb.sh drosophila \
    "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/001/215/GCF_000001215.4_Release_6_plus_ISO1_MT/GCF_000001215.4_Release_6_plus_ISO1_MT_rna.fna.gz" \
    "Drosophila melanogaster RefSeq RNA (GCF_000001215.4, Release 6 plus ISO1 MT)" \
    7227

# Drosophila melanogaster — COMPLETE reference genome assembly, same accession
RUN build-blastdb.sh drosophila_genome \
    "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/001/215/GCF_000001215.4_Release_6_plus_ISO1_MT/GCF_000001215.4_Release_6_plus_ISO1_MT_genomic.fna.gz" \
    "Drosophila melanogaster reference genome (GCF_000001215.4, Release 6 plus ISO1 MT)" \
    7227

# Escherichia coli K-12 MG1655 (GCF_000005845.2, ASM584v2)
RUN build-blastdb.sh ecoli \
    "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/005/845/GCF_000005845.2_ASM584v2/GCF_000005845.2_ASM584v2_genomic.fna.gz" \
    "Escherichia coli K-12 MG1655 genome (GCF_000005845.2, ASM584v2)" \
    511145

# SARS-CoV-2 — RefSeq reference assembly ASM985889v3, sequence NC_045512.2
RUN build-blastdb.sh sarscov2 \
    "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/009/858/895/GCF_009858895.2_ASM985889v3/GCF_009858895.2_ASM985889v3_genomic.fna.gz" \
    "SARS-CoV-2 reference genome NC_045512.2 (GCF_009858895.2, ASM985889v3)" \
    2697049

# Mixed viral set, kept for continuity with searches already in users' history.
# Two organisms, so a per-accession taxid map rather than a single taxid:
#   2697049 = Severe acute respiratory syndrome coronavirus 2
#     11676 = Human immunodeficiency virus 1
COPY scripts/viruses.taxmap /tmp/viruses.taxmap
RUN build-blastdb.sh viruses \
    "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=NC_045512.2,NC_001802.1&rettype=fasta&retmode=text" \
    "SARS-CoV-2 (NC_045512.2) and HIV-1 (NC_001802.1) reference genomes" \
    @/tmp/viruses.taxmap

# Fail the image build if any database cannot be opened, or if its organism
# name does not resolve — a hit with no scientific name is a defect, not a
# warning, because the results table and the AI prompt both depend on it.
COPY scripts/verify-blastdbs.sh /usr/local/bin/verify-blastdbs.sh
RUN chmod +x /usr/local/bin/verify-blastdbs.sh && verify-blastdbs.sh

WORKDIR /app
